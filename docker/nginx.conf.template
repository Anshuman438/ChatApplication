server {
    listen ${PORT};
    server_name _;

    root /var/www/html;
    index index.html;

    # Static web chat application
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Direct Desktop Client .jar Download
    location /download/ChatApp-Desktop.jar {
        alias /var/www/downloads/ChatApp-Desktop.jar;
        add_header Content-Disposition 'attachment; filename="ChatApp-Desktop.jar"';
    }

    # WebSocket Reverse Proxy to Java Chat Server
    location /ws {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;

        # WebSocket headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Keep alive for long active chat sessions
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
